# PostgreSQL
POSTGRES_DB=pms_hotel
POSTGRES_USER=pms_user
POSTGRES_PASSWORD=change_me
# Port de la base sur la machine, pour le développement : à changer s'il est déjà pris
POSTGRES_PORT=5432

# JWT : clé HMAC en base64, d'au moins 256 bits.
# Valeur de démonstration, publique puisqu'elle est dans le dépôt : elle ne convient qu'à
# la démo locale. Pour tout autre usage, en générer une avec : openssl rand -base64 32
JWT_SECRET=qg3xyk5xuarbiH/767ABW4ABdxwNmoXmsMHKdRJFzDo=

# Port du front sur la machine : l'application s'ouvre sur http://localhost:3000
FRONT_PORT=3000
